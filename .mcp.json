{
    "mcpServers": {
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        },
        "supabase": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@supabase/mcp-server-supabase@latest",
                "--project-ref",
                "ybyyxcuvxuzrledbitky"
            ],
            "env": {
                "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
            }
        },
        "figma-desktop": {
            "type": "http",
            "url": "http://127.0.0.1:3845/mcp",
            "transport": "httpStream"
        },
        "puppeteer": {
            "command": "npx",
            "args": [
                "-y",
                "puppeteer-mcp-server"
            ],
            "env": {}
        }
    }
}